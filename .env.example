# ============================================================================
# 1. Supabase Project Credentials
# Copy this file to .env.local (and add to Vercel Environment Variables)
# Find these in Supabase Dashboard -> Project Settings -> API
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (Server-only! Used by /api/alerts/check so cron-job.org can
# check & trigger pending price alerts 24/7 when no browser is signed in)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================================
# 2. Global Market Price Alerts + Telegram Bot + cron-job.org Scheduler
# ============================================================================
# Create a bot via @BotFather on Telegram -> paste the token below:
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Message your bot once, then get your numeric Chat ID via @userinfobot or /getUpdates:
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Random secret string to protect /api/alerts/check from unauthorized public pings
# Pass in cron-job.org as Header `Authorization: Bearer <CRON_SECRET>` or `?secret=<CRON_SECRET>`
CRON_SECRET=replace-with-a-random-secret-string

# Optional primary market data API key (https://twelvedata.com — 800 free credits/day).
# If omitted, moneyprinter automatically falls back to live Swissquote / Coinbase / Yahoo feeds.
TWELVE_DATA_API_KEY=

# Optional default countdown interval in seconds on /admin/alerts (default: 120 = 2 mins)
NEXT_PUBLIC_ALERT_POLL_SECONDS=120
